{
	"name": "n8n-nodes-sharetribe",
	"version": "0.2.1",
	"description": "n8n community node for Sharetribe marketplace platform integration",
	"license": "MIT",
	"homepage": "https://github.com/tribebuilder/n8n-nodes-sharetribe",
	"keywords": [
		"n8n-community-node-package",
		"sharetribe",
		"marketplace",
		"e-commerce",
		"automation",
		"workflow",
		"integration",
		"api"
	],
	"author": {
		"name": "Greg Long",
		"email": "greg@tribebuilder.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tribebuilder/n8n-nodes-sharetribe.git"
	},
	"scripts": {
		"build": "npm run generate:schemas && n8n-node build",
		"generate:metadata": "node ../n8n/packages/core/bin/generate-metadata",
		"build:watch": "tsc --watch",
		"generate:schemas": "npx tsx scripts/generateSchemas.ts",
		"kill:n8n": "lsof -ti:5678 | xargs kill -9 2>/dev/null || true",
		"dev": "n8n-node dev",
		"n8n": "N8N_USER_FOLDER=$HOME/.n8n-node-cli npx n8n@latest",
		"import:templates": "npm run n8n -- import:workflow --separate --input=./workflows/public-templates",
		"test:e2e": "npx tsx scripts/runE2eTests.ts",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SharetribeOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Sharetribe/Sharetribe.node.js",
			"dist/nodes/Sharetribe/SharetribeTrigger.node.js"
		]
	},
	"devDependencies": {
		"@jest/globals": "^30.2.0",
		"@n8n/node-cli": "*",
		"@types/jest": "^30.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/lodash": "^4.17.23",
		"@types/luxon": "^3.7.1",
		"@types/node": "^24.10.1",
		"eslint": "9.32.0",
		"jest": "^30.2.0",
		"jest-mock-extended": "^4.0.0",
		"js-yaml": "^4.1.1",
		"nock": "^14.0.10",
		"prettier": "3.6.2",
		"release-it": "^19.2.4",
		"ts-jest": "^29.4.6",
		"ts-json-schema-generator": "^2.5.0",
		"tsx": "^4.19.3",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"luxon": "^3.7.2",
		"n8n-workflow": "^2.7.0"
	}
}
