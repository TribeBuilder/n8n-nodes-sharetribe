			"typeVersion": 1,
			"position": [
				460,
				460
			],
			"parameters": {
				"content": "**Step 2:** Opens the closed fixture listing",
				"width": 220,
				"height": 100
			}
		},
		{
			"id": "step-note-close-listing",
			"name": "Step 3",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
