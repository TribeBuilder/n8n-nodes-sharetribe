				680,
				300
			],
			"credentials": {
				"sharetribeOAuth2Api": {
					"id": "sharetribe-e2e",
					"name": "Sharetribe E2E"
				}
			},
			"parameters": {
				"resource": "user",
				"operation": "updatePermissions",
				"userId": "{{FIXTURE_USER_ID}}",
				"canCreateListings": true,
				"canInitiateTransactions": true,
				"canRead": true
			}
		},
		{
			"id": "step-note-trigger",
