			"position": [
				240,
				120
			],
			"parameters": {
				"content": "## User - Update Permissions\n\n⚠️ **MUTATING** — Self-cleaning\n\nTests toggling user permissions, then restoring.\n\n**Input:** `FIXTURE_USER_ID` from config\n\n**Steps:**\n1. Manual trigger\n2. Disable `canCreateListings` permission\n3. Re-enable `canCreateListings` permission\n\n**Expected output:** User with all permissions restored to true",
				"color": 5
			}
		},
		{
			"id": "trigger-user-updatepermissions",
			"name": "Manual Trigger",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [
				240,
				300
			],
			"parameters": {}
		},
		{
			"id": "sharetribe-user-updatepermissions-disable",
			"name": "Disable Listings Permission",
			"type": "CUSTOM.sharetribe",
			"typeVersion": 1,
			"position": [
				460,
				300
			],
			"credentials": {
				"sharetribeOAuth2Api": {
					"id": "sharetribe-e2e",
					"name": "Sharetribe E2E"
				}
			},
			"parameters": {
				"resource": "user",
				"operation": "updatePermissions",
				"userId": "{{FIXTURE_USER_ID}}",
				"canCreateListings": false,
				"canInitiateTransactions": true,
				"canRead": true
			}
		},
		{
			"id": "sharetribe-user-updatepermissions-restore",
			"name": "Restore Listings Permission",
			"type": "CUSTOM.sharetribe",
			"typeVersion": 1,
