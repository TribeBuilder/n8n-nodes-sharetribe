{
	"id": "e2e-user-update-profile",
	"name": "[E2E] User - Update Profile",
	"active": false,
	"settings": {
		"executionOrder": "v1"
	},
	"tags": [
		{
			"name": "e2e"
		},
		{
			"name": "sharetribe"
		},
		{
			"name": "user"
		}
	],
	"nodes": [
		{
			"id": "sticky-user-updateprofile",
			"name": "Note",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [
				240,
				120
			],
			"parameters": {
				"content": "## User - Update Profile\n\n⚠️ **MUTATING** — Self-cleaning\n\nTests updating user publicData, then reverting.\n\n**Input:** `FIXTURE_USER_ID` from config\n\n**Steps:**\n1. Manual trigger\n2. Set `E2eTestFlag` on user publicData\n3. Delete `E2eTestFlag` to restore original state\n\n**Expected output:** User with clean publicData (no E2eTestFlag)",
				"color": 5
			}
		},
		{
			"id": "trigger-user-updateprofile",
			"name": "Manual Trigger",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [
				240,
				300
			],
			"parameters": {}
		},
		{
			"id": "sharetribe-user-updateprofile-set",
			"name": "Set Test Data",
			"type": "CUSTOM.sharetribe",
			"typeVersion": 1,
			"position": [
				460,
				300
			],
			"credentials": {
				"sharetribeOAuth2Api": {
					"id": "sharetribe-e2e",
					"name": "Sharetribe E2E"
				}
			},
			"parameters": {
				"resource": "user",
				"operation": "updateProfile",
				"userId": "{{FIXTURE_USER_ID}}",
				"profileFields": {
					"publicData": {
						"mode": "manual",
						"fields": {
							"values": [
								{
									"name": "E2eTestFlag",
									"type": "string",
									"value": "true"
								}
							]
						}
					}
				}
			}
		},
		{
			"id": "sharetribe-user-updateprofile-revert",
			"name": "Revert Test Data",
			"type": "CUSTOM.sharetribe",
			"typeVersion": 1,
			"position": [
				680,
				300
			],
			"credentials": {
				"sharetribeOAuth2Api": {
					"id": "sharetribe-e2e",
					"name": "Sharetribe E2E"
				}
			},
			"parameters": {
				"resource": "user",
				"operation": "updateProfile",
				"userId": "{{FIXTURE_USER_ID}}",
				"deleteFields": {
					"paths": [
						{
							"path": "publicData.E2eTestFlag"
						}
					]
				}
			}
		},
		{
			"id": "step-note-trigger",
			"name": "Step 1",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [
				240,
				460
			],
			"parameters": {
				"content": "**Step 1:** Manual trigger starts the workflow",
				"width": 220,
				"height": 100
			}
		},
		{
			"id": "step-note-set-test-data",
			"name": "Step 2",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [
				460,
				460
			],
			"parameters": {
				"content": "**Step 2:** Sets publicData.E2eTestFlag = \"true\" on the fixture user",
				"width": 220,
				"height": 100
			}
		},
		{
			"id": "step-note-revert-test-data",
			"name": "Step 3",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [
				680,
				460
			],
			"parameters": {
				"content": "**Step 3:** Deletes E2eTestFlag from publicData to revert changes",
				"width": 220,
				"height": 100
			}
		}
	],
	"connections": {
		"Manual Trigger": {
			"main": [
				[
