    {
      "id": "trigger-new-user",
      "name": "New User Signup",
      "type": "CUSTOM.sharetribeTrigger",
      "position": [
        120,
        240
      ],
      "parameters": {
        "resources": [
          "user"
        ],
        "eventTypes": [
          "user/created"
        ],
        "options": {
          "outputFields": {
            "eventAttributes": [
              "createdAt",
              "eventType",
              "resourceId",
              "resource"
            ]
          }
        }
      },
      "credentials": {
        "sharetribeOAuth2Api": {
          "id": "credential-id",
          "name": "Sharetribe Credential"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "http-create-verification",
      "name": "Create Verification Session",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        440,
        240
      ],
      "parameters": {
        "url": "https://api.your-verification-provider.com/v1/verifications",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"person\": {\n    \"firstName\": \"{{ $json.resource.profile.firstName }}\",\n    \"lastName\": \"{{ $json.resource.profile.lastName }}\",\n    \"email\": \"{{ $json.resource.email }}\"\n  },\n  \"vendorData\": \"{{ $json.resourceId }}\",\n  \"callbackUrl\": \"https://your-n8n-instance.com/webhook/verification-callback\"\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "credential-id",
          "name": "Verification API Key"
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "webhook-callback",
      "name": "Verification Callback",
      "type": "n8n-nodes-base.webhook",
      "position": [
        120,
        680
      ],
      "webhookId": "verification-callback",
      "parameters": {
        "path": "verification-callback",
        "httpMethod": "POST"
      },
      "typeVersion": 2
    },
    {
      "id": "if-verified",
      "name": "Verification Successful?",
      "type": "n8n-nodes-base.if",
      "position": [
        440,
        680
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.body.status }}",
              "rightValue": "approved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "sharetribe-permissions",
      "name": "Grant User Permissions",
      "type": "CUSTOM.sharetribe",
      "position": [
        760,
        680
      ],
      "parameters": {
        "resource": "user",
        "operation": "updatePermissions",
        "userId": "={{ $json.body.vendorData }}",
        "canCreateListings": true,
        "canInitiateTransactions": true,
        "canRead": true
      },
      "credentials": {
        "sharetribeOAuth2Api": {
          "id": "credential-id",
          "name": "Sharetribe Credential"
        }
      },
      "typeVersion": 1
    }
